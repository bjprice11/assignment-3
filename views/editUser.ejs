<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f0f4f8;
        }
        .card {
            border: none;
            border-top: 5px solid #0d6efd;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .form-control[readonly] {
            background-color: #e9ecef;
            opacity: 1;
        }
        h1 {
            color: #0d6efd;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card p-4">
                    <h1 class="text-center mb-4">Edit User</h1>
                    
                    <% if (typeof error_message !== 'undefined' && error_message) { %>
                        <div class="alert alert-danger"><%= error_message %></div>
                    <% } %>

                    <form action="/editUser/<%= user.username %>" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="originalUsername" class="form-label">Old User Name</label>
                                <input type="text" class="form-control" id="originalUsername" name="originalUsername" value="<%= user.username %>" readonly>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="username" class="form-label text-primary fw-bold">New User Name</label>
                                <input type="text" class="form-control border-primary" id="username" name="username" value="<%= user.username %>" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="originalPassword" class="form-label">Old Password</label>
                                <input type="text" class="form-control" id="originalPassword" name="originalPassword" value="<%= user.password %>" readonly>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="password" class="form-label text-primary fw-bold">New Password</label>
                                <input type="text" class="form-control border-primary" id="password" name="password" value="<%= user.password %>" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="oldLevel" class="form-label">Old Level</label>
                                <input type="text" class="form-control" id="oldLevel" name="oldLevel" value="<%= user.level %>" readonly>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="level" class="form-label text-primary fw-bold">New Level</label>
                                <select class="form-select border-primary" id="level" name="level" required>
                                    <option value="M" <%= user.level === 'M' ? 'selected' : '' %>>Manager</option>
                                    <option value="U" <%= user.level === 'U' ? 'selected' : '' %>>User</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <input type="submit" class="btn btn-primary" value="Update User">
                            <a href="/users" class="btn btn-outline-secondary">Back to Users</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>