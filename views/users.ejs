<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Users List</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <style>
            :root {
                /* Updated to Professional Blue Theme */
                --theme-blue: #0d6efd;
                --theme-dark-blue: #003366;
                --theme-light: #f0f8ff;
                --theme-border: #dee2e6;
            }
            body {
                background-color: #f4f7f6; /* Professional light grey-blue background */
                font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }
            .content-wrapper {
                background-color: #ffffff;
                padding: 2.5rem;
                border-radius: 15px;
                box-shadow: 0 6px 20px rgba(0,0,0,0.05);
                margin-top: 2rem;
                margin-bottom: 2rem;
                border-top: 6px solid var(--theme-blue);
            }
            h1 {
                color: var(--theme-dark-blue);
                font-weight: 700;
                text-align: center;
                border-bottom: 3px solid var(--theme-blue);
                padding-bottom: 15px;
                margin-bottom: 2rem !important;
            }
            .table thead th {
                 background-color: var(--theme-dark-blue);
                 color: white;
                 border-color: #002244;
                 text-transform: uppercase;
                 font-size: 0.9rem;
                 letter-spacing: 0.5px;
            }
            .table-striped > tbody > tr:nth-of-type(odd) > * {
                background-color: var(--theme-light);
            }
            .table-hover tbody tr:hover {
                background-color: #e2efff; /* Very light blue on hover */
            }
            .btn-primary {
                background-color: var(--theme-blue);
                border-color: var(--theme-blue);
            }
            .btn-primary:hover {
                background-color: #0056b3;
            }
            /* Keeping delete button red for semantic danger meaning, but styling it cleaner */
            .btn-danger {
                background-color: #dc3545;
                border: none;
            }
        </style>
        </head>
    <body>
        
        <div class="container content-wrapper">
            <h1 class="mb-4">Users List</h1>
            
            <div class="row justify-content-center">
                <div class="col-md-10"> <% 
                        if (typeof level !== 'undefined' && level === "M") { 
                    %>
                        <div class="d-flex justify-content-end mb-3">
                            <a href="/addUser" class="btn btn-primary shadow-sm" method ="GET">
                                + Add New User
                            </a>
                        </div>
                    <% } %>
                    
                    <% if (typeof error_message !== 'undefined' && error_message) { %>
                        <div class="alert alert-danger shadow-sm" role="alert">
                            <%= error_message %>
                        </div>
                    <% } %>
            
                    <% if (users.length === 0) { %>
                        <div class="alert alert-info" role="alert">
                            No users found in the database.
                        </div>
                    <% } else { %>
                        <div class="table-responsive shadow-sm rounded">
                            <table class="table table-striped table-hover table-bordered mb-0">
                                <thead> 
                                    <tr>
                                        <th>Name</th>
                                        <th>Password</th>
                                        <th>Level</th>
                                        <th class="text-center">Delete</th>
                                        <th class="text-center">Edit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% for (let iCount = 0; iCount < users.length; iCount++) { %>
                                        <tr>
                                            <td class="align-middle"><%= users[iCount].username %></td>
                                            <td class="align-middle"><%= users[iCount].password %></td>
                                            <td class="align-middle">
                                                <% if(users[iCount].level === 'M') { %>
                                                    <span class="badge bg-primary">Manager</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">User</span>
                                                <% } %>
                                            </td>
                                            <td class="text-center align-middle">
                                                <form action="/deleteUser/<%= users[iCount].username %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                </form>
                                            </td>
                                            <td class="text-center align-middle">
                                                <form action="/editUser/<%= users[iCount].username %>" method="GET">
                                                    <button type="submit" class="btn btn-outline-primary btn-sm">Edit</button>
                                                </form>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div> 
        </div> 
        <div>
            <form action="/" method="get">
                <div class="d-grid mx-5 mb-4">
                    <input type="submit" value="Back to Pokemon List" class="btn btn-primary btn-lg shadow-sm">
                </div>
        </div>
        
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>