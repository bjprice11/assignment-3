<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Searched Pokemon</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5"></div>
        <h1 class="mb-4">Searched Pokemon Result</h1>

        <% if (typeof error_message !== 'undefined' && error_message) { %>
            <div class="alert alert-danger" role="alert">
                <%= error_message %>
            </div>
        <% } %>

        <% if (pokemon.length === 0) { %>
            <div class="alert alert-warning" role="alert">
                No pokemon found matching your search criteria.
            </div>
        <% } else { %>
            <table class="table table-striped">
                <thead> 
                    <tr>
                        <th>Name</th>
                        <th>Power</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let iCount = 0; iCount < pokemon.length; iCount++) { %>
                        <tr>
                            <td><%= pokemon[iCount].description %></td>
                            <td><%= pokemon[iCount].base_total %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        <% } %>
    <form action="/searchedPokemon"  method="POST" >
        <fieldset>
            <legend>Search for Another Pokemon</legend>
            <label for="searchedId">Enter Pokemon Name:</label>
            <input type="text" id ="searchedId" name="name" required="True" maxlength="30">
            <input type="submit" value="Search">
        </fieldset>
    </form>

    <form action="/">
        <fieldset>
            <legend>Go Back to Full List</legend>
            <a href="/" class="btn btn-primary">Full Pokemon List</a>
        </fieldset>
    </form>
</body>
</html>